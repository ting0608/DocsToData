OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# Ollama local models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_VECTOR_DIM=768

# Set to true on Google Cloud Run (OpenAI-only). Omit or false locally to use Ollama.
DISABLE_OLLAMA=false

# Optional: enable persistent storage in Google Cloud Storage.
# When set, uploads and FAISS index files are mirrored to this bucket.
GCS_BUCKET=
GCS_PREFIX=go-invoice

# AWS Cognito authentication.
# Leave all three blank to run in open "dev mode" (no login required).
# Once all three are set, every API route requires a valid Cognito access token
# and the frontend will show the login screen (Hosted UI + optional SSO/social IdPs).
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Hosted UI domain, e.g. https://your-app.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=

# Comma-separated list of allowed origins for CORS. "*" is fine for local dev.
CORS_ALLOW_ORIGINS=*
